{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mkdir -p ../web/dist && wrangler dev --env dev",
    "deploy": "wrangler deploy --env production --minify",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "migrate": "wrangler d1 migrations apply job-bot-dev --local --env dev",
    "generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@resume-bot/shared": "workspace:*",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.13.13",
    "openai": "^7.48.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "wrangler": "^4.149.0"
  }
}
